          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "A small promise to yourself :)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给自己的一个小承诺 :)"
          }
        }
      }
    },
    "Habit name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "习惯名称"
          }
        }
      }
    },
